# ---------------------------------------------------------------------
# SONORA — environment
# Copy to `.env.local` and fill in.
#
# If NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are absent,
# the app runs in LOCAL DEMO MODE:
#   • auth is simulated and stored in localStorage
#   • the library is stored in localStorage
#   • everything still works — no database required
# ---------------------------------------------------------------------

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
